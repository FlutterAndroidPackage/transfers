{
  "permissions": {
    "allow": [
      "PowerShell(flutter analyze*)",
      "PowerShell(flutter build *)"
    ],
    "deny": [
      "PowerShell(*curl*)",
      "PowerShell(*wget*)",
      "PowerShell(*Invoke-WebRequest*)",
      "PowerShell(*Invoke-RestMethod*)",
      "PowerShell(*iwr *)",
      "PowerShell(*irm *)",
      "PowerShell(*localhost*)",
      "PowerShell(*appsettings*)",
      "PowerShell(*Remove-Item*)",
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/android/local.properties)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:api.tuodominio.com)"
    ]
  }
}
