{
  "permissions": {
    "deny": [
      "Read(**/appsettings.json)",
      "Read(**/appsettings.*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/android/local.properties)",
      "WebFetch(domain:api.tuodominio.com)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["pub.dev", "storage.googleapis.com"]
    }
  }
}